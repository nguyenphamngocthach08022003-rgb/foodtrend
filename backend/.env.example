# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL (dùng DB Postgres thật của bạn)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodtrend
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Đơn hàng
DEFAULT_DELIVERY_FEE=15000

# Chống spam lượt xem (phút)
VIEW_SPAM_WINDOW_MINUTES=30

# Reset mật khẩu
PASSWORD_RESET_EXPIRES_MINUTES=30

# ---------------------------------------------------------
# GMAIL CỦA SHOP — dùng để gửi mã xác nhận đăng ký / quên mật khẩu
# Cần bật Xác minh 2 bước cho Gmail rồi tạo "Mật khẩu ứng dụng" (16 ký tự):
#   https://myaccount.google.com/apppasswords
# KHÔNG dùng mật khẩu đăng nhập Gmail thường. Xem README mục "Cấu hình Gmail".
# ---------------------------------------------------------
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=FoodTrend

# Quy tắc mã xác nhận (có thể bỏ qua, đã có giá trị mặc định)
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=6
